# Railway worker Dockerfile
# Build context: backend/ (when using RAILWAY_DOCKERFILE_PATH)

FROM python:3.11-slim as builder

WORKDIR /app

RUN apt-get update && apt-get install -y \
    gcc \
    postgresql-client \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Production stage
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    postgresql-client \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

COPY . .

RUN chmod +x /app/scripts/*.sh

RUN groupadd -r appuser && useradd -r -g appuser -d /app -s /sbin/nologin appuser \
    && chown -R appuser:appuser /app

ENV PYTHONUNBUFFERED=1

# Lightweight health check: verify celery process is alive.
# The old `celery inspect ping` spawned a full Celery client every 30s,
# adding ~100MB memory and timing out during long tasks, causing Railway
# to kill the container in a crash loop.
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=5 \
    CMD pgrep -f "celery.*worker" > /dev/null || exit 1

USER appuser

ENTRYPOINT ["/app/scripts/startup.sh"]
CMD ["worker"]
