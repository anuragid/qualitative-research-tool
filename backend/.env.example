# Backend environment variables only.
# Do NOT add VITE_* variables here — those belong in frontend/.env.
# See frontend/.env.example for frontend config.

# Cloudflare R2 Storage (S3-compatible)
R2_ACCESS_KEY_ID=your_r2_access_key_here
R2_SECRET_ACCESS_KEY=your_r2_secret_key_here
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=your-bucket-name

# AI API Keys - OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
DEFAULT_MODEL=meta-llama/llama-4-scout
ASSEMBLYAI_API_KEY=your_assemblyai_key_here

# Clerk Authentication
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
# CLERK_JWT_KEY is fetched dynamically via JWKS at runtime; only set if you
# need to pin a specific PEM public key for local offline verification.
CLERK_JWT_KEY=
# CLERK_ISSUER pins the expected JWT `iss` claim. When set, tokens minted by
# the same JWKS for a different Clerk context are rejected. REQUIRED in
# production (boot fails without it). This is your Clerk Frontend API URL:
#   - Development instance: https://<slug>.clerk.accounts.dev
#   - Production custom domain: https://clerk.<your-domain>  (e.g. https://clerk.methodex.ai)
# Find the exact value in the Clerk Dashboard (API Keys -> "Frontend API URL").
# Leave empty for local dev to skip the issuer check.
CLERK_ISSUER=

# Database (Local Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qualitative_research

# Redis (Local Docker)
REDIS_URL=redis://localhost:6379/0

# Application Settings
APP_ENV=development
DEBUG=True
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# API Settings
API_V1_PREFIX=/api
PROJECT_NAME=Qualitative Research Tool

# Encryption key for BYOK API keys (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# Sentry Error Monitoring (optional — Sentry is silently disabled when DSN is empty)
SENTRY_DSN=
SENTRY_ORG=your_sentry_org_here
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here

# File Upload Settings
MAX_FILE_SIZE_MB=500
ALLOWED_VIDEO_EXTENSIONS=[".mp4",".mov",".webm",".avi"]
