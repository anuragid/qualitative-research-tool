# Railway Production Environment Variables
# Set these in Railway dashboard or via CLI

# Application
APP_ENV=production
DEBUG=False
PROJECT_NAME=Qualitative Research Tool
API_V1_PREFIX=/api

# Database - Railway provides this automatically via $DATABASE_URL
# DATABASE_URL=postgresql://...

# Redis - Railway provides this automatically via $REDIS_URL
# REDIS_URL=redis://...

# CORS - Update with your production domain
ALLOWED_ORIGINS=https://your-domain.com

# Cloudflare R2 Storage
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=qualitative-research-videos

# LLM - OpenRouter
OPENROUTER_API_KEY=your_openrouter_key
DEFAULT_MODEL=meta-llama/llama-4-scout:free

# Transcription
ASSEMBLYAI_API_KEY=your_assemblyai_key

# Clerk Authentication
CLERK_SECRET_KEY=your_clerk_secret
CLERK_PUBLISHABLE_KEY=your_clerk_publishable

# Encryption key for BYOK API keys (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your_fernet_key

# File Upload Settings
MAX_FILE_SIZE_MB=500
ALLOWED_VIDEO_EXTENSIONS=[".mp4",".mov",".webm",".avi"]
