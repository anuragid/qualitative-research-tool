# Production Environment Configuration for Qualitative Research Tool
# ============================================================================
# Copy this file to .env.production and update with your actual production values
# IMPORTANT: Never commit actual production credentials to version control!

# Application
APP_ENV=production
DEBUG=False
PROJECT_NAME=Qualitative Research Tool
API_V1_PREFIX=/api

# Database - AWS RDS PostgreSQL
DATABASE_URL=postgresql://prod_user:CHANGE_ME@your-rds-endpoint.us-east-2.rds.amazonaws.com:5432/qualitative_research_prod

# Redis - AWS ElastiCache
REDIS_URL=redis://your-elasticache-endpoint.amazonaws.com:6379/0

# CORS - Your production frontend domains
ALLOWED_ORIGINS=https://yourapp.com,https://www.yourapp.com

# Cloudflare R2 Storage - Production bucket
R2_ACCESS_KEY_ID=YOUR_PRODUCTION_R2_KEY
R2_SECRET_ACCESS_KEY=YOUR_PRODUCTION_R2_SECRET
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=qualitative-research-videos-prod

# AI APIs - OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEY=YOUR_PRODUCTION_OPENROUTER_KEY
DEFAULT_MODEL=qwen/qwen3-235b-a22b:free
ASSEMBLYAI_API_KEY=YOUR_PRODUCTION_ASSEMBLYAI_KEY

# ============================================================================
# CLERK AUTHENTICATION - PRODUCTION KEYS
# ============================================================================
# CRITICAL: Replace with your PRODUCTION Clerk keys from:
# https://dashboard.clerk.com/ → Your App → API Keys
#
# Production keys start with:
# - CLERK_SECRET_KEY=sk_live_...
# - CLERK_PUBLISHABLE_KEY=pk_live_...
#
# The system will automatically detect production keys and log:
# "🔒 Running with PRODUCTION Clerk keys"
# ============================================================================

CLERK_SECRET_KEY=sk_live_YOUR_PRODUCTION_SECRET_KEY
CLERK_PUBLISHABLE_KEY=pk_live_YOUR_PRODUCTION_PUBLISHABLE_KEY
CLERK_JWT_KEY=  # Optional - we use JWKS for verification

# LLM Settings (via OpenRouter)
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

# File Upload Settings
MAX_FILE_SIZE_MB=500
ALLOWED_VIDEO_EXTENSIONS=[".mp4",".mov",".webm",".avi"]

# ============================================================================
# PRODUCTION CHECKLIST
# ============================================================================
# Before deploying to production, ensure:
#
# 1. Clerk Setup:
#    ✓ Created production Clerk application
#    ✓ Updated frontend with production publishable key
#    ✓ Configured production domain in Clerk dashboard
#    ✓ Set up custom JWT template with metadata (if needed)
#
# 2. Database:
#    ✓ Run all Alembic migrations
#    ✓ Set up automated backups
#    ✓ Configure connection pooling
#
# 3. Security:
#    ✓ All secrets stored in AWS Secrets Manager or similar
#    ✓ HTTPS enforced for all endpoints
#    ✓ CORS properly configured for frontend domains only
#    ✓ Rate limiting enabled
#
# 4. Monitoring:
#    ✓ CloudWatch logs configured
#    ✓ Error tracking (Sentry, etc.) set up
#    ✓ Health check endpoints tested
#
# 5. Role Management:
#    ✓ Assign first admin user in Clerk dashboard:
#       - Go to Users → Select user → Public metadata
#       - Add: {"role": "admin"}
#
# ============================================================================
