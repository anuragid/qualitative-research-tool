# AWS Cognito Authentication Configuration
# Copy this file to .env and update with your values

# Application
APP_ENV=development
DEBUG=True
PROJECT_NAME="Qualitative Research Tool"
API_V1_PREFIX="/api"

# CORS - Add your frontend URLs
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# Database
DATABASE_URL="postgresql://user:password@localhost/qualitative_research"

# Redis
REDIS_URL="redis://localhost:6379/0"

# AWS Configuration
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
AWS_REGION="us-east-1"
AWS_BUCKET_NAME="your-s3-bucket-name"

# AWS Cognito Configuration
USE_COGNITO_AUTH=True  # Set to True to use Cognito instead of Clerk
COGNITO_USER_POOL_ID="us-east-1_Jr0OTariE"
COGNITO_APP_CLIENT_ID="2oah1h1bdsushki851ftkale6h"
COGNITO_REGION="us-east-1"

# Clerk Configuration (Deprecated - will be removed after migration)
# Leave these empty when using Cognito
CLERK_SECRET_KEY=""
CLERK_PUBLISHABLE_KEY=""
CLERK_JWT_KEY=""

# AI APIs
ANTHROPIC_API_KEY="your-anthropic-api-key"
ASSEMBLYAI_API_KEY="your-assemblyai-api-key"

# Claude Settings
CLAUDE_MODEL="claude-sonnet-4-20250514"
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=0.7

# File Upload Settings
MAX_FILE_SIZE_MB=500

# Celery Settings (Optional - defaults to Redis URL if not set)
CELERY_BROKER_URL=""
CELERY_RESULT_BACKEND=""