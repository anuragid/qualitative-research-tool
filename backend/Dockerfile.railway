# Railway-optimized Dockerfile
# Build context: project root (set by railway.toml buildContext = ".")

# Pinned 2026-04-04 — check for updates quarterly
FROM python:3.11.12-slim as builder

WORKDIR /app

RUN apt-get update && apt-get install -y \
    gcc \
    postgresql-client \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Production stage
# Pinned 2026-04-04 — check for updates quarterly
FROM python:3.11.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    postgresql-client \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy Python dependencies from builder
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy only backend application code
COPY backend/ .

# Make scripts executable
RUN chmod +x /app/scripts/*.sh

# Create non-root user for security
RUN groupadd -r appuser && useradd -r -g appuser -d /app -s /sbin/nologin appuser \
    && chown -R appuser:appuser /app

ENV PYTHONUNBUFFERED=1

EXPOSE 8000

# Health check - conditional on service type
# Worker: check that the celery main process is alive (lightweight, no Redis round-trip)
# The old `celery inspect ping` spawned a full Celery client every 30s, adding ~100MB
# memory pressure and timing out when the worker was busy with long tasks, causing
# Railway to kill the container in a crash loop.
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=5 \
    CMD if [ "$SERVICE_TYPE" = "worker" ]; then \
            pgrep -f "celery.*worker" > /dev/null || exit 1; \
        else \
            curl -f http://localhost:8000/health || exit 1; \
        fi

USER appuser

ENTRYPOINT ["/app/scripts/startup.sh"]
CMD ["api"]
