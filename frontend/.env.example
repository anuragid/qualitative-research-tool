# Backend API URL
VITE_API_URL=http://localhost:8000

# Clerk Authentication
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
# VITE_CLERK_PROXY_URL is only needed in production (set in Cloudflare Pages env vars)

# Dev auth bypass — skip Clerk login, use backend's dev_user_local identity.
# Set to "true" for local development (requires backend APP_ENV=development).
# NEVER set in production builds.
VITE_DEV_AUTH_BYPASS=true

# Application
VITE_APP_ENV=development
VITE_APP_NAME=Qualitative Research Tool

# Sentry error monitoring (optional — leave empty to disable)
VITE_SENTRY_DSN=

# Web3Forms contact form access key (optional — contact form button disabled when empty)
VITE_WEB3FORMS_KEY=
