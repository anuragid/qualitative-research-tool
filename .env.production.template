# Railway Deployment Environment Variables Template
# Copy this file and fill in your actual values

# ============================================
# Backend Environment Variables (Railway)
# ============================================

# Database (Railway provides this automatically)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_RAILWAY_HOST:5432/railway

# AI Services
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# OpenRouter (OpenAI-compatible LLM gateway)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Cloudflare R2 Storage (S3-compatible)
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET_NAME=your_r2_bucket_name

# Redis (Railway provides this automatically)
REDIS_URL=redis://your-redis-endpoint:6379

# Authentication (Clerk)
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# Encryption for BYOK API keys (generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())')
ENCRYPTION_KEY=your_fernet_key_here

# Application
APP_ENV=production
DEBUG=false
ALLOWED_ORIGINS=https://your-frontend-domain.pages.dev
MAX_FILE_SIZE_MB=500
ALLOWED_VIDEO_EXTENSIONS=[".mp4",".mov",".avi",".webm"]

# ============================================
# Frontend Environment Variables (Cloudflare Pages)
# ============================================

# API Endpoint
VITE_API_URL=https://your-backend.up.railway.app

